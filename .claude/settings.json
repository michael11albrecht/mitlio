{
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(flutter:*)",
      "Bash(dart:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue view:*)",
      "Bash(gh run:*)",
      "Bash(supabase:*)",
      "Bash(tool/drive.sh:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf /:*)",
      "Bash(supabase db push:*)",
      "Bash(supabase link:*)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/tool/hooks/format_file.sh" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/tool/hooks/stop_check.sh", "timeout": 600 }]
      }
    ]
  }
}
