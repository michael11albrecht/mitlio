  "fixed_sql": [
    {
      "name": "groups",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"groups\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"currency\" TEXT NOT NULL, \"created_by\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "members",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"members\" (\"id\" TEXT NOT NULL, \"group_id\" TEXT NOT NULL REFERENCES \"groups\" (id), \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"name\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, \"paypal_me\" TEXT NULL, \"user_id\" TEXT NULL, \"iban_hint\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "expenses",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"expenses\" (\"id\" TEXT NOT NULL, \"group_id\" TEXT NOT NULL REFERENCES \"groups\" (id), \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"title\" TEXT NOT NULL, \"amount_cents\" INTEGER NOT NULL CHECK(\"amount_cents\" > 0), \"currency\" TEXT NOT NULL, \"fx_rate_ppm\" INTEGER NOT NULL CHECK(\"fx_rate_ppm\" > 0), \"group_amount_cents\" INTEGER NOT NULL CHECK(\"group_amount_cents\" > 0), \"date\" TEXT NOT NULL, \"category\" TEXT NULL, \"type\" TEXT NOT NULL CHECK(\"type\" IN ('regular', 'trip', 'settlement')), \"split_mode\" TEXT NOT NULL CHECK(\"split_mode\" IN ('equal', 'shares', 'percent', 'exact')), \"trip_meta\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "expense_payers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"expense_payers\" (\"group_id\" TEXT NOT NULL REFERENCES \"groups\" (id), \"expense_id\" TEXT NOT NULL REFERENCES expenses (id), \"member_id\" TEXT NOT NULL REFERENCES members (id), \"paid_cents\" INTEGER NOT NULL CHECK(\"paid_cents\" > 0), PRIMARY KEY (\"expense_id\", \"member_id\"));"
        }
      ]
    },
    {
      "name": "expense_shares",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"expense_shares\" (\"group_id\" TEXT NOT NULL REFERENCES \"groups\" (id), \"expense_id\" TEXT NOT NULL REFERENCES expenses (id), \"member_id\" TEXT NOT NULL REFERENCES members (id), \"share_cents\" INTEGER NOT NULL CHECK(\"share_cents\" > -1), \"weight\" INTEGER NOT NULL CHECK(\"weight\" > -1), PRIMARY KEY (\"expense_id\", \"member_id\"));"
        }
      ]
    },
    {
      "name": "settlements",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settlements\" (\"id\" TEXT NOT NULL, \"group_id\" TEXT NOT NULL REFERENCES \"groups\" (id), \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"from_member\" TEXT NOT NULL REFERENCES members (id), \"to_member\" TEXT NOT NULL REFERENCES members (id), \"amount_cents\" INTEGER NOT NULL CHECK(\"amount_cents\" > 0), \"currency\" TEXT NOT NULL, \"date\" TEXT NOT NULL, \"method\" TEXT NOT NULL CHECK(\"method\" IN ('paypal', 'sepa', 'cash', 'other')), PRIMARY KEY (\"id\"));"
        }
      ]
    },
