---
import { calculatorMessages } from '../i18n/calculator';
import { messages, type Locale } from '../i18n';
import { defaultState, MAX_TRIP_NAME, type CalcState } from '../calculator/core';
import { APP_STORE_URL, FUEL_API_ANON_KEY, FUEL_API_URL, PLAY_STORE_URL, ROUTE_API_URL } from '../../site.config.mjs';
import { FUEL_TYPES } from '../lib/fuel';
import { buildDeepLink } from '../lib/deeplink';

interface Props {
  locale: Locale;
  /** Landing pages: starting values for the form (URL params still win in the island). */
  preset?: Partial<CalcState>;
  /** Km-rate mode: price field is the rate per km, consumption and drive type are hidden. */
  rate?: boolean;
}

const { locale, preset = {}, rate = false } = Astro.props;
const m = calculatorMessages[locale];
const label = messages[locale].calculatorLabel;
// Static defaults so the page is stable before the island runs.
const d: CalcState = { ...defaultState(preset.energy ?? 'fuel'), ...preset };
const decimal = (v: string) => (locale === 'de' ? v.replace('.', ',') : v);
const storesLive = APP_STORE_URL !== '' || PLAY_STORE_URL !== '';
const ev = d.energy === 'ev';
// Live fuel price chips need a configured API and a per-litre price field (not the km-rate page).
const fuelEnabled = FUEL_API_URL !== '' && !rate;
// From-to route row: opt-in, behind the ROUTE_WEB build flag (empty ROUTE_API_URL means off, nothing rendered).
const routeEnabled = ROUTE_API_URL !== '';
const consLabel = `${ev ? m.consumptionEv : m.consumptionFuel} (${ev ? m.consumptionEvUnit : m.consumptionFuelUnit})`;
const consUnit = ev ? m.consumptionEvUnit : m.consumptionFuelUnit;
const priceLabel = rate ? `${m.priceRate} (${m.priceRateUnit})` : `${ev ? m.priceEv : m.priceFuel} (${ev ? m.priceEvUnit : m.priceFuelUnit})`;
const priceUnit = rate ? m.priceRateUnit : ev ? m.priceEvUnit : m.priceFuelUnit;
const rowLabel = rate ? m.rowRate : ev ? m.rowEv : m.rowFuel;
const ctaDeepLink = buildDeepLink({
  km: Number(d.km),
  l100: Number(d.cons),
  price: Number(d.price),
  n: Number(d.persons),
  d: d.driverPays,
  rt: d.roundTrip,
  ev: ev || undefined,
});
---

<div
  id="calculator"
  role="region"
  aria-label={label}
  data-locale={locale}
  data-mode={rate ? 'rate' : undefined}
  data-preset={Object.keys(preset).length > 0 ? JSON.stringify(preset) : undefined}
>
  <div class="result" id="calc-result" data-state="loading">
    <div aria-live="polite" aria-atomic="true">
      <p class="result-lead" id="calc-result-lead">{m.loading}</p>
      <p class="result-amount" id="calc-result-amount">–</p>
      <p class="result-sub" id="calc-result-sub" hidden></p>
      <p class="result-extra" id="calc-result-extra" hidden></p>
    </div>
    <details class="breakdown">
      <summary>{m.breakdown}</summary>
      <dl>
        <div>
          <dt id="calc-b-fuel-label">{rowLabel}</dt>
          <dd id="calc-b-fuel">–</dd>
        </div>
        <div id="calc-b-wear-row" hidden>
          <dt>{m.rowWear}</dt>
          <dd id="calc-b-wear">–</dd>
        </div>
        <div id="calc-b-extras-row" hidden>
          <dt>{m.rowExtras}</dt>
          <dd id="calc-b-extras">–</dd>
        </div>
        <div class="total">
          <dt>{m.rowTotal}</dt>
          <dd id="calc-b-total">–</dd>
        </div>
      </dl>
    </details>
    <div class="share" id="calc-share" hidden>
      <button type="button" class="btn" id="calc-share-native" hidden>{m.share}</button>
      <div class="share-fallback" id="calc-share-fallback" role="group" aria-label={m.shareGroup} hidden>
        <a class="btn" id="calc-share-wa" href="https://wa.me/" target="_blank" rel="noopener noreferrer">{m.shareWhatsapp}</a>
        <button type="button" class="btn" id="calc-share-copy">{m.shareCopy}</button>
      </div>
      <p class="share-status" id="calc-share-status" role="status"></p>
    </div>
  </div>

  <form class="inputs" novalidate>
    <fieldset class="segmented" hidden={rate}>
      <legend>{m.energy}</legend>
      <label>
        <input type="radio" name="energy" value="fuel" checked={!ev} />
        <span>{m.energyFuel}</span>
      </label>
      <label>
        <input type="radio" name="energy" value="ev" checked={ev} />
        <span>{m.energyEv}</span>
      </label>
    </fieldset>

    {
      fuelEnabled && (
        <div
          class="fuel"
          id="calc-fuel"
          role="group"
          aria-labelledby="calc-fuel-title"
          data-api={FUEL_API_URL}
          data-key={FUEL_API_ANON_KEY || undefined}
          hidden
        >
          <div class="fuel-head">
            <p class="fuel-title" id="calc-fuel-title">
              {m.fuelTitle}
            </p>
            {/* Which price this is. Icon + text, never colour alone; the icon follows data-scope. */}
            <p class="fuel-scope" id="calc-fuel-scope" data-scope="" hidden>
              <svg class="scope-icon scope-national" viewBox="0 0 16 12" aria-hidden="true" focusable="false">
                <rect width="16" height="4" y="0" fill="#000" />
                <rect width="16" height="4" y="4" fill="#d00" />
                <rect width="16" height="4" y="8" fill="#ffce00" />
              </svg>
              <svg class="scope-icon scope-nearby" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="M8 1.5a4.5 4.5 0 0 0-4.5 4.5c0 3.2 4.5 8.5 4.5 8.5S12.5 9.2 12.5 6A4.5 4.5 0 0 0 8 1.5Z" fill="none" stroke="currentColor" stroke-width="1.5" />
                <circle cx="8" cy="6" r="1.6" fill="currentColor" />
              </svg>
              <svg class="scope-icon scope-plz" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2.5 2" />
                <circle cx="8" cy="8" r="1.6" fill="currentColor" />
              </svg>
              <span id="calc-fuel-scope-text" />
            </p>
          </div>
          <div class="fuel-where" id="calc-fuel-where" hidden>
            <button type="button" class="chip chip-action" id="calc-fuel-nearby">
              {m.fuelNearby}
            </button>
            {/* Not a <form>: this block sits inside the calculator form and forms cannot nest. */}
            <div class="fuel-plz" id="calc-fuel-plz-group">
              <label for="calc-fuel-plz">{m.fuelPlz}</label>
              <input id="calc-fuel-plz" type="text" inputmode="numeric" maxlength="5" autocomplete="postal-code" />
              <button type="button" class="chip chip-action" id="calc-fuel-plz-go">
                {m.fuelPlzGo}
              </button>
            </div>
          </div>
          <div class="chips" id="calc-fuel-chips">
            {FUEL_TYPES.map((t) => (
              <button type="button" class="chip" data-fuel={t} hidden aria-pressed="false">
                <span class="chip-name">{t === 'diesel' ? 'Diesel' : t.toUpperCase()}</span>{' '}
                <span class="chip-price" />
              </button>
            ))}
          </div>
          <p class="fuel-status" id="calc-fuel-status" role="status" />
        </div>
      )
    }

    <div class="grid">
      <div class="field">
        <label for="calc-km">{m.distance} ({m.distanceUnit})</label>
        <div class="control">
          <input id="calc-km" type="text" inputmode="decimal" autocomplete="off" value={decimal(d.km)} />
          <span class="unit" aria-hidden="true">{m.distanceUnit}</span>
        </div>
        <p class="error" id="calc-km-error" hidden></p>
      </div>

      <div class="field" hidden={rate}>
        <label for="calc-cons" id="calc-cons-label">{consLabel}</label>
        <div class="control">
          <input id="calc-cons" type="text" inputmode="decimal" autocomplete="off" value={decimal(d.cons)} />
          <span class="unit" id="calc-cons-unit" aria-hidden="true">{consUnit}</span>
        </div>
        <p class="error" id="calc-cons-error" hidden></p>
      </div>

      <div class="field">
        <label for="calc-price" id="calc-price-label">{priceLabel}</label>
        <div class="control">
          <input id="calc-price" type="text" inputmode="decimal" autocomplete="off" value={decimal(d.price)} />
          <span class="unit" id="calc-price-unit" aria-hidden="true">{priceUnit}</span>
        </div>
        <p class="error" id="calc-price-error" hidden></p>
      </div>

      <div class="field">
        <label for="calc-persons">{m.persons}</label>
        <div class="stepper">
          <button type="button" id="calc-persons-dec" aria-label={m.personsLess}>−</button>
          <input id="calc-persons" type="text" inputmode="numeric" autocomplete="off" value={d.persons} />
          <button type="button" id="calc-persons-inc" aria-label={m.personsMore}>+</button>
        </div>
        <p class="error" id="calc-persons-error" hidden></p>
      </div>
    </div>

    {
      routeEnabled && (
        <details class="route" id="calc-route" data-api={ROUTE_API_URL} data-key={FUEL_API_ANON_KEY || undefined}>
          <summary>{m.routeToggle}</summary>
          <div class="route-body">
            <div class="field">
              <label for="calc-route-from">{m.routeFrom}</label>
              <input id="calc-route-from" type="text" autocomplete="off" maxlength="120" />
              <ul class="route-list" id="calc-route-from-list" aria-label={m.routeSuggestionsFrom} hidden />
            </div>
            <div class="field">
              <label for="calc-route-to">{m.routeTo}</label>
              <input id="calc-route-to" type="text" autocomplete="off" maxlength="120" />
              <ul class="route-list" id="calc-route-to-list" aria-label={m.routeSuggestionsTo} hidden />
            </div>
            <button type="button" class="chip chip-action" id="calc-route-recalc" hidden>
              {m.routeRecalc}
            </button>
            <p class="route-status" id="calc-route-status" role="status" />
            <p class="route-note">{m.routeNote}</p>
            <p class="route-note" id="calc-route-attribution" hidden />
          </div>
        </details>
      )
    }

    <div class="switches">
      <label class="switch">
        <span>{m.driverPays}</span>
        <input id="calc-driver-pays" type="checkbox" role="switch" checked={d.driverPays} />
      </label>
      <label class="switch">
        <span>{m.roundTrip}</span>
        <input id="calc-round-trip" type="checkbox" role="switch" checked={d.roundTrip} />
      </label>
    </div>

    <div class="wear" hidden={rate}>
      <label class="switch">
        <span>{m.wear}</span>
        <input id="calc-wear" type="checkbox" role="switch" />
      </label>
      <div class="wear-detail" id="calc-wear-detail" hidden>
        <p class="wear-hint">{m.wearHint}</p>
        <button type="button" class="wear-own" id="calc-wear-own">{m.wearOwn}</button>
        <div class="field" id="calc-wear-field" hidden>
          <label for="calc-wearRate">{m.wearOwnLabel}</label>
          <div class="control">
            <input id="calc-wearRate" type="text" inputmode="decimal" autocomplete="off" placeholder="0,07" />
            <span class="unit" aria-hidden="true">{m.wearUnit}</span>
          </div>
          <p class="error" id="calc-wearRate-error" hidden></p>
        </div>
      </div>
    </div>

    <div class="field">
      <label for="calc-extras">{m.extras} <span class="optional">({m.extrasOptional})</span></label>
      <div class="control">
        <input id="calc-extras" type="text" inputmode="decimal" autocomplete="off" placeholder="0" value={decimal(d.extras)} />
        <span class="unit" aria-hidden="true">{m.extrasUnit}</span>
      </div>
      <p class="error" id="calc-extras-error" hidden></p>
    </div>

    <div class="field">
      <label for="calc-trip">{m.tripLabel} <span class="optional">({m.tripOptional})</span></label>
      <input
        id="calc-trip"
        type="text"
        maxlength={MAX_TRIP_NAME}
        autocomplete="off"
        placeholder={m.tripPlaceholder}
        value=""
      />
    </div>
  </form>

  {
    fuelEnabled && (
      <div class="fuel-foot" id="calc-fuel-foot" hidden>
        <p class="fuel-source" id="calc-fuel-source" hidden />
        <p class="fuel-note" id="calc-fuel-note" hidden>
          {m.fuelLocationNote}
        </p>
      </div>
    )
  }

  <aside class="cta" id="calc-cta" aria-label="mitlio App">
    <p>{m.ctaText}</p>
    {
      storesLive ? (
        <div class="cta-actions">
          {APP_STORE_URL && (
            <a class="btn" href={APP_STORE_URL} rel="noopener">{m.ctaAppStore}</a>
          )}
          {PLAY_STORE_URL && (
            <a class="btn" href={PLAY_STORE_URL} rel="noopener">{m.ctaPlay}</a>
          )}
          {!rate && (
            <a class="btn" id="calc-cta-open" href={ctaDeepLink}>{m.ctaOpen}</a>
          )}
        </div>
      ) : (
        <p class="cta-soon">{m.ctaSoon}</p>
      )
    }
  </aside>

  <noscript><p class="error">{m.noscript}</p></noscript>
</div>

<script is:inline defer src="/mitlio_domain.js"></script>
<script>
  import '../calculator/island';
</script>

<style>
  #calculator {
    display: grid;
    gap: var(--space-4);
  }

  .result {
    background: var(--color-primary);
    color: var(--color-on-primary);
    border-radius: var(--radius);
    padding: var(--space-6);
    min-height: 11rem;
  }

  .result[data-state='empty'] {
    background: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .result p {
    margin: 0;
  }

  .result-lead {
    font-size: 1.125rem;
    font-weight: 600;
  }

  .result-amount {
    font-size: clamp(2.75rem, 13vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }

  .result .result-sub {
    margin-top: var(--space-2);
    font-size: 1.125rem;
    font-weight: 600;
  }

  .result .result-extra {
    margin-top: var(--space-2);
    font-size: 0.9rem;
  }

  .result[data-state='empty'] .result-sub {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .breakdown {
    margin-top: var(--space-4);
    border-top: 1px solid color-mix(in srgb, currentColor 35%, transparent);
    padding-top: var(--space-2);
  }

  .breakdown summary {
    cursor: pointer;
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    font-weight: 600;
    list-style: none;
  }

  .breakdown summary::-webkit-details-marker {
    display: none;
  }

  /* display:flex removes the native triangle, so draw a chevron: the row must look expandable. */
  .breakdown summary::after {
    content: '';
    width: 0.6rem;
    height: 0.6rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    transition: transform 0.15s;
    margin-right: var(--space-1);
  }

  .breakdown[open] summary::after {
    transform: rotate(225deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .breakdown summary::after {
      transition: none;
    }
  }

  .breakdown dl {
    margin: 0 0 var(--space-2);
  }

  .breakdown dl > div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-1);
  }

  .breakdown dt,
  .breakdown dd {
    margin: 0;
  }

  .breakdown dd {
    font-variant-numeric: tabular-nums;
  }

  .breakdown .total {
    font-weight: 700;
    border-top: 1px solid color-mix(in srgb, currentColor 35%, transparent);
    margin-top: var(--space-1);
    padding-top: var(--space-2);
  }

  .share {
    margin-top: var(--space-4);
    border-top: 1px solid color-mix(in srgb, currentColor 35%, transparent);
    padding-top: var(--space-4);
  }

  .share-fallback {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .share-status {
    margin: var(--space-2) 0 0;
    min-height: 1.4em;
    font-size: 0.9rem;
  }

  /* Outlined so it reads on the coloured result card and on the plain CTA card. */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding-inline: var(--space-4);
    font: inherit;
    font-weight: 600;
    color: inherit;
    text-decoration: none;
    background: transparent;
    border: 2px solid currentColor;
    border-radius: 0.5rem;
    cursor: pointer;
  }

  .btn:hover {
    background: color-mix(in srgb, currentColor 12%, transparent);
  }

  .btn:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 2px;
  }

  .cta {
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .cta p {
    margin: 0;
  }

  .cta-soon {
    margin-top: var(--space-2);
    font-weight: 700;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
    color: var(--color-primary);
  }

  .inputs {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 34rem) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .fuel {
    display: grid;
    gap: var(--space-2);
  }

  .fuel[hidden],
  .chip[hidden],
  .fuel-source[hidden],
  .fuel-scope[hidden],
  .fuel-note[hidden],
  .fuel-foot[hidden],
  .fuel-where[hidden] {
    display: none;
  }

  .fuel-title {
    margin: 0;
    font-weight: 600;
  }

  .fuel-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  /* Which price this is: Germany average, nearby or a postcode area. Icon + text, right next to the title. */
  .fuel-scope {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    padding: 0.125rem var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .fuel-scope[data-scope='nearby'],
  .fuel-scope[data-scope='plz'] {
    border-color: var(--color-primary);
  }

  .scope-icon {
    display: none;
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  .fuel-scope[data-scope='national'] .scope-national,
  .fuel-scope[data-scope='nearby'] .scope-nearby,
  .fuel-scope[data-scope='plz'] .scope-plz {
    display: block;
  }

  /* Where the price is for comes first (scope, then the controls to change it), the prices follow. */
  .fuel-where {
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .chips,
  .fuel-where {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    line-height: 1.2;
    padding-inline: var(--space-4);
    font: inherit;
    color: var(--color-text);
    background: var(--color-bg);
    border: 2px solid var(--color-border-strong);
    border-radius: 999px;
    cursor: pointer;
  }

  .chip:hover {
    border-color: var(--color-primary);
  }

  .chip:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .chip-name {
    font-weight: 700;
  }

  .chip-price {
    font-variant-numeric: tabular-nums;
  }

  .chip[aria-pressed='true'] {
    color: var(--color-on-primary);
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  .chip-action {
    align-items: center;
    font-weight: 600;
  }

  .fuel-source,
  .fuel-note,
  .fuel-status {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .fuel-foot {
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-4);
  }

  .fuel-status:empty {
    display: none;
  }

  .fuel-plz {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .fuel-plz label {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .fuel-plz input[type='text'] {
    width: 6.5rem;
    min-height: 2.75rem;
    font-size: 1rem;
  }

  .route {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-2);
  }

  .route summary {
    cursor: pointer;
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: underline;
  }

  .route summary:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .route-body {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  .route-body .field {
    justify-self: stretch;
  }

  .route-list {
    list-style: none;
    margin: var(--space-1) 0 0;
    padding: 0;
    border: 1px solid var(--color-border-strong);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .route-list[hidden],
  .route-status:empty,
  #calc-route-attribution[hidden],
  #calc-route-recalc[hidden] {
    display: none;
  }

  .route-option {
    display: block;
    width: 100%;
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-3);
    font: inherit;
    text-align: left;
    color: var(--color-text);
    background: var(--color-bg);
    border: 0;
    border-bottom: 1px solid var(--color-border);
    cursor: pointer;
  }

  .route-option:hover {
    background: var(--color-surface);
  }

