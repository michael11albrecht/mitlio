---
import { getCollection } from 'astro:content';
import Calculator from './Calculator.astro';
import Layout from '../layouts/Layout.astro';
import { messages, paths, htmlLang, landingPath, type Locale } from '../i18n';
import { organization, webApplication } from '../lib/jsonld';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages[locale];
const site = Astro.site!;
const pages = await getCollection(locale === 'de' ? 'landing' : 'landingEn');
const jsonLd = [
  organization(site.href),
  webApplication({
    name: t.calculatorLabel,
    url: new URL(paths.home[locale], site).href,
    description: t.homeDescription,
    lang: htmlLang[locale],
  }),
];
---

<Layout locale={locale} route="home" title={t.homeTitle} description={t.homeDescription} jsonLd={jsonLd} appBanner>
  <h1>{t.heroTitle}</h1>
  <p class="lead">{t.heroLead}</p>
  <Calculator locale={locale} />
  {
    pages.length > 0 && (
      <nav class="related" aria-labelledby="related-heading">
        <h2 id="related-heading">
          {locale === 'de' ? 'Ratgeber und Rechner für jede Fahrt' : 'Guides and calculators for every trip'}
        </h2>
        <ul>
          {pages.map((p) => (
            <li>
              <a href={landingPath(locale, p.id)}>{p.data.linkLabel}</a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</Layout>
