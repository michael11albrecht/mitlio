---
import '../styles/global.css';
import { APP_STORE_URL } from '../../site.config.mjs';
import { defaultState } from '../calculator/core';
import { buildDeepLink } from '../lib/deeplink';
import { htmlLang, locales, messages, paths, type Locale, type RouteKey } from '../i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Route used for canonical + hreflang. Omit for pages without alternates (404). */
  route?: RouteKey;
  /** Canonical path for indexable pages without a language alternate (no hreflang is emitted). */
  path?: string;
  /** Paired landing pages: path per locale, replaces `route`. x-default points to German. */
  alternates?: Record<Locale, string>;
  /** Path of the Open Graph / Twitter card image (1200x630 PNG). Defaults to the home card. */
  ogImage?: string;
  /** Structured data objects, each emitted as its own application/ld+json script. */
  jsonLd?: object[];
  noindex?: boolean;
  /** Emit the iOS smart app banner meta (only when APP_STORE_URL is configured). */
  appBanner?: boolean;
}

const {
  locale,
  title,
  description,
  route,
  path,
  alternates,
  ogImage = '/og/home.png',
  jsonLd = [],
  noindex = false,
  appBanner = false,
} = Astro.props;
const appId = /\/id(\d+)/.exec(APP_STORE_URL)?.[1];
const d = defaultState();
// The calculator island rewrites app-argument with the current trip.
const appArgument = buildDeepLink({
  km: Number(d.km),
  l100: Number(d.cons),
  price: Number(d.price),
  n: Number(d.persons),
  d: d.driverPays,
  rt: d.roundTrip,
});
const t = messages[locale];
const other: Locale = locale === 'de' ? 'en' : 'de';
const site = Astro.site!;
const abs = (path: string) => new URL(path, site).href;
const pair = alternates ?? (route ? paths[route] : undefined);
const canonical = pair ? abs(pair[locale]) : path ? abs(path) : undefined;
const ogUrl = abs(ogImage);
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1514" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {
      pair && locales.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={abs(pair[l])} />)
    }
    {pair && <link rel="alternate" hreflang="x-default" href={abs(pair.de)} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {
      !noindex && (
        <>
          <meta property="og:image" content={ogUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
          <meta name="twitter:image" content={ogUrl} />
        </>
      )
    }
    {
      jsonLd.map((data) => (
        <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
      ))
    }
    {
      appBanner && appId && (
        <meta id="apple-itunes-app" name="apple-itunes-app" content={`app-id=${appId}, app-argument=${appArgument}`} />
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipLink}</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={paths.home[locale]}>{t.siteName}</a>
        <a class="lang" href={(pair ?? paths.home)[other]} hreflang={htmlLang[other]} lang={t.otherLanguageLang}
          >{t.otherLanguage}</a
        >
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <nav aria-label="Footer">
          <ul>
            <li><a href={paths.imprint[locale]}>{t.imprint}</a></li>
            <li><a href={paths.privacy[locale]}>{t.privacy}</a></li>
          </ul>
        </nav>
      </div>
    </footer>
  </body>
</html>
